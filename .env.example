# =============================================================================
# GPS Tracking Platform — environment configuration
# Kopieer dit bestand naar .env en vul de waarden in.
# Zet NOOIT echte geheimen in het repository.
# ===================================================================###########

# --- Database (verplicht) ----------------------------------------------------
# PostgreSQL connectie-string. Op productie: sterk wachtwoord, alleen localhost.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/gps_tracking?schema=public"

# --- Applicatie ---------------------------------------------------------------
# Publieke basis-URL van de web-app (voor links/redirects achter proxy).
APP_URL="https://gps.example.com"

# --- Admin-account (wordt aangemaakt door `npm run db:seed`) ------------------
# ADMIN_PASSWORD: minimaal 8 tekens. Laat leeg => seed genereert een sterk
# wachtwoord en toont dit eenmalig in de console.
ADMIN_EMAIL="admin@gps.local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# --- Kaarten -------------------------------------------------------------------
# CARTO basemap key (publiek zichtbaar in de frontend — geen geheim).
NEXT_PUBLIC_CARTO_KEY=""

# --- Teltonika TCP-ingestie (machine-tot-machine) -----------------------------
# Gedeelde sleutel tussen de GPS TCP-service en POST /api/ingest/teltonika.
# Genereer met: openssl rand -hex 32
TELTONIKA_INGEST_KEY=""

# --- GPS TCP-service (teltonika/server.mjs) -----------------------------------
# Poort waarop de AVL TCP-listener luistert (device verbindt hiermee).
GPS_TCP_PORT=5027
# Optioneel: bind-adres (default 0.0.0.0). Zet 127.0.0.1 als een nginx
# stream-proxy de publieke poort afhandelt.
GPS_TCP_HOST=0.0.0.0
# Idle-timeout voor device-verbindingen in seconden (0 = UITGESCHAKELD, standaard).
# LET OP: gebruik GEEN korte idle-timeout — apparaten kunnen lang zwijgen op een
# open verbinding (bv. uurlijkse batches). Alleen inschakelen met vlootbeleid.
GPS_TCP_IDLE_TIMEOUT=0
# Handshake-timeout: verbinding moet binnen Xs de IMEI-handshake afronden.
GPS_TCP_HANDSHAKE_TIMEOUT=30
# Onvolledig frame + stilte langer dan Xs = corrupte stroom -> verbinding resetten.
GPS_TCP_PARTIAL_FRAME_TIMEOUT=60
# TCP keepalive-probes (ms) om dode peers te detecteren zonder actieve sockets te killen.
GPS_TCP_KEEPALIVE_MS=60000
# HTTP debug-dashboard van de TCP-service (alleen intern / firewall).
GPS_HTTP_PORT=8787
# URL waar de TCP-service gedecodeerde records naar toe duwt (Next.js app).
WEB_INGEST_URL="http://127.0.0.1:3000/api/ingest/teltonika"

# --- GPS TLS (optioneel, zie DEPLOYMENT.md sectie "Network security") ---------
# Zet certificaatpaden om TLS op de AVL-listener af te dwingen (node:tls).
# GPS_TLS_CERT=/etc/gps/tls/server.crt
# GPS_TLS_KEY=/etc/gps/tls/server.key
# GPS_TLS_CA=/etc/gps/tls/ca.crt
# GPS_TLS_REJECT_UNAUTHORIZED=true

# --- Tracking state drempels (seconden) ---------------------------------------
# GPS-data versheid: ONLINE binnen deze tijd na laatste record.
FRESH_ONLINE_S=120
# OFFLINE na deze tijd; daartussen: stale (nog wel laatste positie zichtbaar).
FRESH_OFFLINE_S=900
# Hardware-apparaten sturen periodiek batches: ruimere grens voor "verbonden".
DEVICE_ONLINE_S=7200
DEVICE_OFFLINE_S=21600

# --- Health-check van de GPS TCP-service (optioneel) ---------------------------
# Waar /api/health de TCP-service op kan pollen; leeg = overslaan.
GPS_TCP_HEALTH_URL="http://127.0.0.1:8787/health"

# =============================================================================
# ONGEBRUIKT IN DE CODE (legacy — bewust verwijderd uit configuratie-eisen):
#   AUTH_SECRET / AUTH_TRUST_HOST : sessies zijn DB-gebaseerd (geen JWT).
#   ADMIN_BUILD_API_KEY           : nergens gerefereerd; verwijderd uit .env.
# Als je ze al in .env hebt staan, kun je ze veilig weghalen.
# =============================================================================
