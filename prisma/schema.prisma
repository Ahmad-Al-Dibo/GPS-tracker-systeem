// Prisma schema — GPS Fleet Management Platform
// Uitbreiding op bestaand accounts/API-key model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  user
  admin
}

enum EventStatus {
  new
  under_review
  resolved
  dismissed
}

enum Severity {
  info
  warning
  critical
}

enum TaskStatus {
  open
  in_progress
  overdue
  done
  cancelled
}

enum TaskPriority {
  low
  medium
  high
  urgent
}

enum RuleFieldType {
  speed_kmh
  latitude
  longitude
  last_seen_age_s
  hour_of_day
  day_of_week
}

enum RuleOperator {
  gt
  gte
  lt
  lte
  eq
  neq
  between
  outside_hours
  outside_days
  enters_geofence
  leaves_geofence
}

enum RuleLogic {
  single
  and_all
  or_any
}

enum NotificationChannel {
  in_app
}

enum JobRunStatus {
  running
  success
  failed
}

enum DeviceStatus {
  pending
  active
  revoked
}

enum DeviceType {
  HARDWARE
  SOFTWARE
}

// ─── Users & Auth (bestaand, uitgebreid) ────────────────

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  username     String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(user)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  session       Session?
  apiKeys       ApiKey[]
  sources       IngestSource[]
  eventsAssigned Event[]     @relation("AssignedUser")
  tasksCreated  Task[]       @relation("TaskCreator")
  tasksAssigned Task[]       @relation("TaskAssignee")
  auditLogs     AuditLog[]
  notifications Notification[]
  personsDeleted Person[]    @relation("PersonDeletedBy")
  vehiclesDeleted IngestSource[] @relation("VehicleDeletedBy")
  locationsCreated ManagedLocation[] @relation("LocationCreatedBy")
  routesCreated   Route[]       @relation("RouteCreatedBy")
  devicesOwned    GpsDevice[]

  @@map("users")
}

model Session {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")
  expiresAt       DateTime  @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  keyHash     String    @unique @map("key_hash")
  keyPrefix   String    @map("key_prefix")
  label       String    @default("Default")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_keys")
}

// ─── Vehicles (uitgebreid IngestSource) ─────────────────

model IngestSource {
  id             String   @id @default(uuid()) @db.Uuid
  ownerUserId    String?  @map("owner_user_id") @db.Uuid
  name           String   @unique
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?   @map("accuracy_meters")
  speedMps       Float?   @map("speed_mps")
  sampledAt      DateTime? @map("sampled_at")
  receivedAt     DateTime @default(now()) @map("received_at")
  eventId        String?  @unique @map("event_id")
  lastError      String?  @map("last_error")
  iconEmoji      String?  @default("📍") @map("icon_emoji")
  displayName    String?  @map("display_name")
  description    String?

  // ── Voertuig-gegevens (US-04) ──
  licensePlate   String?  @map("license_plate")
  brand          String?  /// Merk
  vehicleType    String?  @map("vehicle_type")  /// Type/model
  color          String?
  yearOfBuild    Int?     @map("year_of_build")
  chassisNumber  String?  @map("chassis_number")
  startingKm     Float?   @map("starting_km")  /// Startkilometerstand
  currentKm      Float?   @map("current_km")   /// Huidige berekende km-stand
  totalDistanceKm Float?  @map("total_distance_km")  /// Totale gereden afstand
  vehicleGroup   String?  @map("vehicle_group")
  isActive       Boolean  @default(true) @map("is_active")
  notes          String?

  // ── Tracker-gegevens (US-05) ──
  trackerSerial  String?  @map("tracker_serial")  /// Serienummer
  trackerBrand   String?  @map("tracker_brand")
  trackerType    String?  @map("tracker_type")
  simCardNumber  String?  @map("sim_card_number")
  /// "physical" = fysieke tracker, "app" = telefoon-app
  trackerSource  String?  @default("app") @map("tracker_source")

  // ── Uniforme tracker-identiteit (Phase 2) ──
  /// Stabiele externe identiteit: Teltonika-IMEI of app-install-UUID.
  /// Nooit de naam — die kan veranderen. Uniek over alle trackers.
  externalId     String?  @unique @map("external_id")
  /// "hardware" | "mobile" | "legacy" (geen identiteit vóór Phase 2)
  sourceType     String?  @default("legacy") @map("source_type")
  /// Beheerders-metadata (alleen website-PATCH; ingest raakt dit nooit).
  metadata       Json?
  /// Apparaat-gemelde metadata (app); website toont dit apart.
  deviceMetadata Json?    @map("device_metadata")
  /// "unverified" (auto-ontdekt) | "verified" (admin gepaird) | "revoked"
  verificationStatus String? @default("verified") @map("verification_status")
  /// Eerste registratie/verbinding (backfill = createdAt bij migratie).
  firstSeenAt    DateTime? @default(now()) @map("first_seen_at")
  /// SHA-256 van de mobiele trackerKey (enrolment-credential); raw 1× getoond.
  deviceSecretHash String? @unique @map("device_secret_hash")

  // ── Afstand-berekening ──
  lastCalcLat    Float?   @map("last_calc_lat")
  lastCalcLon    Float?   @map("last_calc_lon")
  lastCalcAt     DateTime? @map("last_calc_at")

  // ── Laatst bekende apparaatwaarden (tracker-profiel, Phase 2) ──
  lastAltitude     Float? @map("last_altitude")
  lastHeading      Float? @map("last_heading")
  lastBatteryLevel Int?   @map("last_battery_level")

  iconUrl        String?  @map("icon_url")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // ── Soft delete (prullenbak) ──
  deletedAt      DateTime? @map("deleted_at")
  deletedBy      String?   @map("deleted_by") @db.Uuid

  owner    User?           @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  deletedByUser User?      @relation("VehicleDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  points   IngestPoint[]
  events   Event[]
  tasks    Task[]
  persons  VehiclePerson[]
  devices  GpsDevice[]

  @@index([ownerUserId])
  @@index([vehicleGroup])
  @@index([licensePlate])
  @@index([trackerSerial])
  @@index([deletedAt])
  @@index([sourceType, verificationStatus])
  @@map("ingest_sources")
}

// ─── Personen (US-03) ───────────────────────────────────

model Person {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  phone     String?
  address   String?
  country   String?
  zipcode   String?
  city      String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // ── Soft delete (prullenbak) ──
  deletedAt DateTime? @map("deleted_at")
  deletedBy String?   @map("deleted_by") @db.Uuid

  deletedByUser User? @relation("PersonDeletedBy", fields: [deletedBy], references: [id], onDelete: SetNull)
  vehicles VehiclePerson[]

  @@index([deletedAt])
  @@map("persons")
}

/// Many-to-many: personen ↔ voertuigen (US-07)
model VehiclePerson {
  id        String   @id @default(uuid()) @db.Uuid
  vehicleId String   @map("vehicle_id") @db.Uuid
  personId  String   @map("person_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  vehicle IngestSource @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  person  Person       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, personId])
  @@map("vehicle_persons")
}

model IngestPoint {
  id             String   @id @default(uuid()) @db.Uuid
  sourceId       String   @map("source_id") @db.Uuid
  latitude       Float
  longitude      Float
  speedMps       Float?   @map("speed_mps")
  accuracyMeters Float?   @map("accuracy_meters")
  sampledAt      DateTime @map("sampled_at")
  receivedAt     DateTime @default(now()) @map("received_at")

  // �"?�"? Hardware/AVL-velden (Teltonika FMC920 e.d.) �"?�"?__
  deviceId       String?  @map("device_id") @db.Uuid
  altitude       Float?
  heading        Float?   /// Hoek in graden (0-360)
  satellites     Int?
  priority       Int?
  /// Genormaliseerde IO-elementen: [{id, value, size}]
  ioData         Json?    @map("io_data")
  /// Content-hash (SHA-256) van de canonische recordvelden — dedupe bij
  /// herverzending door het device (geen record-ID in Teltonika-protocol).
  recordHash     String?  @map("record_hash")

  source IngestSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  device GpsDevice?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([sourceId, sampledAt])
  @@index([deviceId, sampledAt])
  /// Retention-job (runRetentionCleanup) filtert op receivedAt < cutoff —
  /// zonder deze index wordt de grootste tabel elke run gescand.
  @@index([receivedAt])
  /// Dedupe-haspel: alleen hardware-records (deviceId gevuld) worden op hash
  /// beschermd; NULL-hash/-deviceId = legacy/software, geen restrictie.
  @@unique([deviceId, recordHash])
  @@map("ingest_points")
}

// �"?�"?�"? GPS-hardware apparaten (US-05/US-06/US-12) �"?�"?�"?

model GpsDevice {
  id            String       @id @default(uuid()) @db.Uuid
  /// HARDWARE = fysieke tracker (IMEI); SOFTWARE = simulator (simulatorId).
  deviceType    DeviceType   @default(HARDWARE) @map("device_type")
  /// Unieke hardware-identificatie (Teltonika IMEI) — NIET de primaire sleutel.
  /// Nullable voor SOFTWARE-apparaten.
  imei          String?      @unique /// Unieke device-identificatie (Teltonika IMEI)
  /// Unieke identificatie voor software-trackers/simulators.
  simulatorId   String?      @unique @map("simulator_id")
  label         String?
  brand         String?      @default("Teltonika")
  model         String?
  simCardNumber String?      @map("sim_card_number")
  firmware      String?
  /// Protocol: "codec8" | "codec8e" | "codec16"
  protocol      String?      @default("codec8e")

  // �"?�"? Autorisatie & lifecycle �"?�"?__
  status        DeviceStatus @default(pending)
  authorizedAt  DateTime?    @map("authorized_at")
  revokedAt     DateTime?    @map("revoked_at")

  // �"?�"? Eigenaarschap (multi-tenancy) �"?�"?__
  ownerUserId   String?      @map("owner_user_id") @db.Uuid

  // �"?�"? Koppeling aan voertuig (US-06) �"?�"?__
  vehicleId     String?      @map("vehicle_id") @db.Uuid
  assignedAt    DateTime?    @map("assigned_at")

  // �"?�"? Live device-status �"?�"?__
  lastSeenAt      DateTime? @map("last_seen_at")      /// Laatste TCP-verbinding/pakket
  lastLat         Float?    @map("last_lat")
  lastLon         Float?    @map("last_lon")
  lastSpeedMps    Float?    @map("last_speed_mps")
  lastFixAt       DateTime? @map("last_fix_at")       /// Laatste geldige GNSS-fix
  lastRecordCount Int       @default(0) @map("last_record_count")

  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  vehicle IngestSource? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  owner   User?         @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  points  IngestPoint[]

  @@index([vehicleId])
  @@index([status])
  @@index([lastSeenAt])
  @@index([ownerUserId])
  @@map("gps_devices")
}

// ─── Rules ──────────────────────────────────────────────

model Rule {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  enabled     Boolean   @default(true)
  logic       RuleLogic @default(single)
  severity    Severity  @default(warning)
  version     Int       @default(1)

  /// Voertuiggroep (null = alle voertuigen)
  vehicleGroup String?  @map("vehicle_group")
  /// Specifieke voertuigen (leeg = alle in groep/alles)
  vehicleIds   String[] @map("vehicle_ids") @db.Uuid

  /// Drempels (voor snelheid etc.)
  thresholdValue Float? @map("threshold_value")
  thresholdMin   Float? @map("threshold_min")
  thresholdMax   Float? @map("threshold_max")
  /// Duur-eis in seconden (bijv. "30s boven drempel")
  durationSec    Int?   @map("duration_sec")
  consecutive    Int?   @map("consecutive_count")

  /// Planning
  timezone       String   @default("Europe/Amsterdam")
  weekdays       Int[]    @default([0,1,2,3,4,5,6]) /// 0=zo..6=za
  timeFrom       String?  @map("time_from") /// "HH:mm"
  timeTo         String?  @map("time_to")

  /// Geofence-koppeling (optioneel)
  geofenceId     String?  @map("geofence_id") @db.Uuid

  /// Event-capture beleid
  preEventPoints    Int  @default(10) @map("pre_event_points")
  postEventPoints   Int  @default(5)  @map("post_event_points")
  retentionDays     Int  @default(30) @map("retention_days")

  /// Notificatie
  notifyInApp Boolean @default(true) @map("notify_in_app")

  /// Acties
  createEvent Boolean @default(true) @map("create_event")
  createTask  Boolean @default(false) @map("create_task")
  taskTitle   String? @map("task_title")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  conditions RuleCondition[]
  events     Event[]
  geofence   Geofence? @relation(fields: [geofenceId], references: [id], onDelete: SetNull)

  @@index([enabled])
  @@map("rules")
}

/// Losse voorwaarde binnen een regel (AND/OR combinatie)
model RuleCondition {
  id       String         @id @default(uuid()) @db.Uuid
  ruleId   String         @map("rule_id") @db.Uuid
  field    RuleFieldType
  operator RuleOperator
  value1   Float?
  value2   Float?

  rule Rule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@map("rule_conditions")
}

// ─── Events ─────────────────────────────────────────────

model Event {
  id            String       @id @default(uuid()) @db.Uuid
  vehicleId     String       @map("vehicle_id") @db.Uuid
  ruleId        String       @map("rule_id") @db.Uuid
  ruleVersion   Int          @map("rule_version")
  severity      Severity     @default(warning)
  status        EventStatus  @default(new)

  startTime     DateTime     @map("start_time")
  endTime       DateTime?    @map("end_time")
  measuredValue Float?       @map("measured_value")
  threshold     Float?
  latitude      Float?
  longitude     Float?
  durationSec   Int?         @map("duration_sec")

  assignedUserId String?     @map("assigned_user_id") @db.Uuid
  reviewNotes    String?     @map("review_notes")
  resolvedAt     DateTime?   @map("resolved_at")
  dismissedAt    DateTime?   @map("dismissed_at")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  vehicle  IngestSource @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  rule     Rule         @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  assignee User?        @relation("AssignedUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  points   EventPoint[]
  tasks    Task[]

  @@index([vehicleId, startTime])
  /// Retention filtert status IN (…) AND createdAt < cutoff — composite
  /// (links-prefix status) dekt beide queries; vervangt losse status-index.
  @@index([status, createdAt])
  @@index([severity])
  @@map("events")
}

/// GPS-bewijspunten gekoppeld aan een event (pre/during/post)
model EventPoint {
  id             String   @id @default(uuid()) @db.Uuid
  eventId        String   @map("event_id") @db.Uuid
  latitude       Float
  longitude      Float
  speedMps       Float?   @map("speed_mps")
  accuracyMeters Float?   @map("accuracy_meters")
  sampledAt      DateTime @map("sampled_at")
  phase          String   @default("during") /// "pre" | "during" | "post"

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, sampledAt])
  @@map("event_points")
}

// ─── Geofences ──────────────────────────────────────────

model Geofence {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  description String?
  color       String   @default("#3b82f6")
  /// Polygon-coördinaten als JSON-array [[lat,lon],...]
  coordinates String   /// JSON string van [[lat,lon],...]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rules Rule[]

  @@map("geofences")
}

// ─── Tasks ──────────────────────────────────────────────

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      TaskStatus   @default(open)
  priority    TaskPriority @default(medium)
  dueDate     DateTime?    @map("due_date")

  vehicleId   String?      @map("vehicle_id") @db.Uuid
  eventId     String?      @map("event_id") @db.Uuid
  creatorId   String       @map("creator_id") @db.Uuid
  assigneeId  String?      @map("assignee_id") @db.Uuid

  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  completedAt DateTime?    @map("completed_at")
  /// Wanneer de deadline-job een over-tijd-melding heeft verstuurd (idempotentie)
  overdueNotifiedAt DateTime? @map("overdue_notified_at")

  vehicle  IngestSource? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  event    Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  creator  User          @relation("TaskCreator", fields: [creatorId], references: [id])
  assignee User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([assigneeId])
  @@index([status, dueDate])
  @@map("tasks")
}

// ─── Notifications ──────────────────────────────────────

model Notification {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  title     String
  body      String?
  severity  Severity           @default(info)
  isRead    Boolean            @default(false) @map("is_read")
  eventId   String?            @map("event_id") @db.Uuid
  channel   NotificationChannel @default(in_app)
  createdAt DateTime           @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ─── Settings ───────────────────────────────────────────

model Settings {
  id     String @id @default(uuid()) @db.Uuid
  /// Eén rij per organisatie; voor nu singleton "default"
  orgKey String @unique @default("default") @map("org_key")

  timezone           String @default("Europe/Amsterdam")
  unitSpeed          String @default("kmh") @map("unit_speed") /// "kmh" | "mph"
  telemetryIntervalS Int    @default(15) @map("telemetry_interval_s")
  offlineThresholdS  Int    @default(120) @map("offline_threshold_s")
  eventRetentionDays Int    @default(30) @map("event_retention_days")
  pointRetentionDays Int    @default(90) @map("point_retention_days")
  notifyInApp        Boolean @default(true) @map("notify_in_app")
  orgName            String  @default("Mijn Organisatie") @map("org_name")
  /// Download-URL van de mobiele tracker-app (leeg = niet gepubliceerd;
  /// de website toont dan GEEN fake downloadlink).
  appDownloadUrl     String? @map("app_download_url")

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

// ─── Audit ──────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id")
  detail      Json?
  createdAt   DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId])
  @@map("audit_logs")
}

// ─── Locaties & Routes (locatiebeheer) ──────────────────

enum LocationType {
  permanent
  temporary
}

/// Beheerde locatie (adres → geocode → coords). Soft delete.
model ManagedLocation {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  address       String
  latitude      Float
  longitude     Float
  /// Welke provider de coords opleverde: "photon" | "nominatim" | "manual"
  geocodeProvider String?    @map("geocode_provider")
  /// Geadresseerde naam zoals de provider die retourneerde
  geocodeLabel  String?      @map("geocode_label")
  type          LocationType @default(permanent)
  /// Geldigheid tijdelijke locaties (exclusief: <= nu = verlopen)
  startsAt      DateTime?    @map("starts_at")
  expiresAt     DateTime?    @map("expires_at")
  notes         String?
  /// Optionele kleur-override; anders type-kleur (permanent=blauw, temporary=oranje)
  color         String?
  createdById   String?      @map("created_by") @db.Uuid
  deletedAt     DateTime?    @map("deleted_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  createdBy  User?         @relation("LocationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  routePoints RoutePoint[]

  @@index([type, expiresAt])
  @@index([deletedAt])
  @@map("managed_locations")
}

model Route {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  description String?
  createdById String?   @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy User?        @relation("RouteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  points    RoutePoint[]

  @@index([deletedAt])
  @@map("routes")
}

/// Bestandspunt van een route. Bewaart een SNAPSHOT van naam/adres/coords
/// plus optionele referentie naar de bron-locatie (wijzigingen aan een
/// gedeelde locatie corrupteren bestaande routes niet).
model RoutePoint {
  id        String  @id @default(uuid()) @db.Uuid
  routeId   String  @map("route_id") @db.Uuid
  orderIndex Int    @map("order_index")
  locationId String? @map("location_id") @db.Uuid
  name      String
  address   String?
  latitude  Float
  longitude Float

  route    Route            @relation(fields: [routeId], references: [id], onDelete: Cascade)
  location ManagedLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([routeId, orderIndex])
  @@index([routeId])
  @@map("route_points")
}

// ─── Scheduled background jobs ──────────────────────────

/// Uitvoeringslog van background jobs; slotKey maakt elke geplande
/// uitvoering uniek → dubbele uitvoering wordt op DB-niveau voorkomen.
model JobRun {
  id         String       @id @default(uuid()) @db.Uuid
  jobName    String       @map("job_name")
  /// Unieke planning-slot-sleutel, bv. "deadline-check@2026-10-18T09:00"
  slotKey    String       @unique @map("slot_key")
  status     JobRunStatus @default(running)
  startedAt  DateTime     @default(now()) @map("started_at")
  finishedAt DateTime?    @map("finished_at")
  durationMs Int?         @map("duration_ms")
  result     Json?
  error      String?

  @@index([jobName, startedAt])
  @@map("job_runs")
}
